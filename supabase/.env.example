# Comma-separated, exact browser origins. Do not use a wildcard in production.
FEEDBACK_ALLOWED_ORIGINS=https://docs.example.com,http://localhost:8000,http://127.0.0.1:8000

# Keep this false in production. It is useful only for local curl requests.
FEEDBACK_ALLOW_MISSING_ORIGIN=false

# Hosted Edge Functions receive SUPABASE_URL and secret keys automatically.
# For local serving, copy the values printed by `supabase status` into an
# untracked .env.local file. Never commit real keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-the-local-secret-key
